  "item": [
    {
      "name": "Sukses",
      "item": [
        {
          "name": "GET semua mahasiswa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mahasiswa"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET mahasiswa ID 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa?id=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mahasiswa"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
