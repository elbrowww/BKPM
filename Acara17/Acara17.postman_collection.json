{
  "info": {
    "name": "Acara 17 - MVC REST API Mahasiswa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/BKPM/Acara17/si-akademik/public"
    }
